{
    "name": "Block Blob",
    "description": "A blob URI blocker",
    "version": "2.0.0",
    "manifest_version": 3,
    "minimum_chrome_version": "96",
    "offline_enabled": true,
    "permissions": [
        "tabs",
        "webRequest",
        "debugger",
        "scripting"
    ],
    "background": {
        "service_worker": "background.bundle.js"
    },
    "host_permissions": ["<all_urls>"]
}